# Files generated/written by the framework at runtime
logs/*
!logs/.gitkeep
!logs/.htaccess
sessions/*
!sessions/.gitkeep
!sessions/.htaccess

# Database backups made by Admin > Tools > Backup / Restore (they contain the
# whole database: users, password hashes and any personal data)
backup/*
!backup/.gitkeep
!backup/.htaccess

# Written by the installer (krsobjm/install/controller/step_1.php) with the
# real path of each installation: they mustn't be versioned with a fixed
# value. See the matching *.example files for the format.
krsobjp/globals.php
krsobjp/admin/globals.php

# Private working notes, not meant for publication
krsobjd/privati/

# System/editor files
.DS_Store
Thumbs.db
*.swp
*~

# Images uploaded through the file manager and their thumbnails (the folder
# and its .htaccess are versioned instead)
krsobjp/image/data/*
!krsobjp/image/data/.gitkeep
krsobjp/image/cache/

# Copies of config.ini made by Admin > Settings before every save
# (they contain the database password)
config/backup/
