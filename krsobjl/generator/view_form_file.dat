<div class="page-header">
	<div class="container-fluid">
		<div class="pull-right">
			<button type="button" data-toggle="tooltip" title="<?php echo $button_save; ?>" class="btn btn-primary submit"><i class="fa fa-save"></i></button>
			<button type="button" data-toggle="tooltip" title="<?php echo $button_cancel; ?>" class="btn btn-default cancel"><i class="fa fa-reply"></i></button>
		</div>
		<h1><?php echo $heading_title; ?></h1>
		<ul class="breadcrumb">
			<?php foreach ($breadcrumbs as $breadcrumb) { ?>
			<li><a href="<?php echo $breadcrumb['href']; ?>"><?php echo $breadcrumb['text']; ?></a></li>
			<?php } ?>
		</ul>
	</div>
</div>

<div class="container-fluid">
	<?php if ($error_warning) { ?>
	<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> <?php echo $error_warning; ?>
		<button type="button" class="close" data-dismiss="alert">&times;</button>
	</div>
	<?php } ?>
	
	<div class="panel panel-default">
		<div class="panel-heading">
			<h3 class="panel-title"><i class="fa fa-pencil"></i> <?php echo $text_form; ?></h3>
		</div>
		<div class="panel-body">
			<form action="<?php echo $action; ?>" method="post" enctype="multipart/form-data" id="form-addition-type" class="form-horizontal">
				{field_input}
				
				{field_hidden}
				<input type="hidden" name="submit" value="submit"/>
			</form>
		</div>
	</div>
</div>

<script type="text/javascript"><!--
$('.submit').click(function() {
	var form = $('#form-addition-type');
	actionKAJAX(form.attr('action'), form.serialize());
	return false;
});

$('.cancel').click(function() {
	actionKAJAX('<?php echo $cancel; ?>');
});
//--></script>

{autocomplete_view}