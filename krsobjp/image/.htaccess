# The file manager saves the files uploaded by users here (data/) and the
# thumbnails (cache/), inside the DocumentRoot: no script must be able to run,
# whatever extension someone manages to give it.
<FilesMatch "\.(?i:php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh|shtml)$">
	Require all denied
</FilesMatch>
Options -ExecCGI
